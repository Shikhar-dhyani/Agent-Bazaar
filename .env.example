# Copy to .env — Docker Compose reads this automatically

# --- API Keys (set whichever provider you use) ---
ANTHROPIC_API_KEY=sk-ant-YOUR_KEY_HERE
GEMINI_API_KEY=YOUR_GEMINI_KEY_HERE

# --- Model overrides (defaults shown, all use Gemini free tier) ---
# BROKER_MODEL=gemini/gemini-2.0-flash
# AGGREGATOR_MODEL=gemini/gemini-2.0-flash
# SCORER_MODEL=gemini/gemini-2.0-flash-lite
