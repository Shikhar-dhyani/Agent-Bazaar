# Copy to .env — Docker Compose reads this automatically

# --- API Keys (set whichever provider you use) ---
ANTHROPIC_API_KEY=sk-ant-YOUR_KEY_HERE
GEMINI_API_KEY=YOUR_GEMINI_KEY_HERE

# --- Model overrides (defaults shown, all use Gemini 2.5 free tier) ---
# Gemini 2.5 Flash:      10-15 RPM, 1500 RPD  — quality tasks
# Gemini 2.5 Flash-Lite: 15-30 RPM, 1500 RPD  — fast/cheap tasks
#
# To switch to Anthropic, uncomment and set all six:
# BROKER_MODEL=claude-haiku-4-5-20251001
# AGGREGATOR_MODEL=claude-haiku-4-5-20251001
# SCORER_MODEL=claude-haiku-4-5-20251001
# SPECIALIST_FAST_MODEL=claude-haiku-4-5-20251001
# SPECIALIST_THOROUGH_MODEL=claude-sonnet-4-6
#
# To stay on Gemini 2.5 (default):
# BROKER_MODEL=gemini/gemini-2.5-flash
# AGGREGATOR_MODEL=gemini/gemini-2.5-flash
# SCORER_MODEL=gemini/gemini-2.5-flash-lite
# SPECIALIST_FAST_MODEL=gemini/gemini-2.5-flash-lite
# SPECIALIST_THOROUGH_MODEL=gemini/gemini-2.5-flash

# --- Fallback model (used when primary is overloaded/503) ---
# FALLBACK_MODEL=gemini/gemini-2.0-flash
