# --- API Keys (set whichever provider you use) ---
ANTHROPIC_API_KEY=sk-ant-YOUR_KEY_HERE
GEMINI_API_KEY=YOUR_GEMINI_KEY_HERE

# --- Model names (change to switch providers) ---
# Gemini free tier  : gemini/gemini-2.0-flash  /  gemini/gemini-2.0-flash-lite
# Anthropic         : claude-sonnet-4-6         /  claude-haiku-4-5-20251001
BROKER_MODEL=gemini/gemini-2.0-flash
AGGREGATOR_MODEL=gemini/gemini-2.0-flash
SCORER_MODEL=gemini/gemini-2.0-flash-lite

# --- Optional infrastructure ---
REDIS_URL=redis://localhost:6379
DATABASE_URL=postgresql+asyncpg://bazaar:bazaar@localhost:5432/agent_bazaar
